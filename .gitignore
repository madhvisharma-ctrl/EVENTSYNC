# =========================================================
# EventSync - Git Ignore
# =========================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environment
venv/
env/
.venv/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Flask
instance/
.webassets-cache/

# SQLite database
database/*.db
database/*.db-shm
database/*.db-wal
*.sqlite
*.sqlite3

# Uploaded/generated face images
static/uploads/
uploads/

# Generated QR files
static/generated/
generated/

# Logs
*.log
logs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# IDEs
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Build / packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Local demo artifacts
screenshots/
exports/